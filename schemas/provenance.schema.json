{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-design.local/schema/provenance.json",
  "type": "object",
  "properties": {
    "rules_version": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "enum": [
              "confirmed",
              "observed",
              "inferred",
              "suspected",
              "unknown"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "confidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "rules_version",
    "assumptions"
  ],
  "additionalProperties": false
}
