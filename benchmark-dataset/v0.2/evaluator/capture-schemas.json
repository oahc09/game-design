                "minLength": 64,
                "maxLength": 64
              },
              "trace": {
                "type": "object",
                "required": [
                  "initial",
                  "transitions"
                ],
                "properties": {
                  "initial": {
                    "type": "object",
                    "required": [
                      "tick",
                      "terminal"
                    ],
                    "properties": {
                      "tick": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "terminal": {
                        "type": [
                          "object",
                          "null"
                        ]
                      }
                    },
                    "additionalProperties": true
                  },
                  "transitions": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "before",
                        "after",
                        "action",
                        "accepted",
